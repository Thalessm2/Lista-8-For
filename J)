class Program//define uma classe chamada Program
{
    static void Main()//define o método Main, que é o ponto de entrada do programa
    {
        int soma = 0;//define uma variável inteira chamada soma e inicializa com 0
        for (int i = 2; i <= 100; i += 2)//define um loop for que itera de 2 a 100, incrementando de 2 em 2
        {
            soma += i;//adiciona o valor de i à variável soma
        }
        Console.WriteLine("A soma dos números pares entre 1 e 100 é: " + soma);//imprime o resultado da soma na tela
    }
}
